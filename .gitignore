# EGT monorepo — never commit secrets, local staging, or build output.

# Secrets & local staging (CRITICAL)
.env
.env.*
!.env.example
staging-local/
*.pem
*.key

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
.next/
out/

# Flutter
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/build/
apps/mobile/*.iml

# Misc
.DS_Store
*.log
.vscode/
.idea/
coverage/
