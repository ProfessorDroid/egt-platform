# EGT Backend — environment template. Copy to .env and fill in.
# NEVER commit real secrets. All values here are placeholders/dev-only.

NODE_ENV=development
PORT=3000

# PostgreSQL connection (see docker-compose.yml for the local dev database)
DATABASE_URL=postgresql://egt:egt_dev_password@localhost:5432/egt?schema=public

# Secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_64_HEX_CHARS_ACCESS_SECRET_DEV_ONLY
JWT_REFRESH_SECRET=REPLACE_WITH_64_HEX_CHARS_REFRESH_SECRET_DEV_ONLY
DOCUMENT_SIGNING_SECRET=REPLACE_WITH_64_HEX_CHARS_DOC_SIGNING_DEV_ONLY

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated CORS allowlist (mobile app scheme + admin dashboard origin)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_REQUEST_BODY_MB=2
MAX_UPLOAD_MB=10
DOCUMENT_STORAGE_DIR=/var/lib/egt-documents
DOCUMENT_URL_TTL_MINUTES=15

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
THROTTLE_DEFAULT_TTL=60
THROTTLE_DEFAULT_LIMIT=120

# SMTP (optional in dev) — needed for verification/reset emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
APP_PUBLIC_URL=http://localhost:3000
