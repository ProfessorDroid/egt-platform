<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links (needs server-side apple-app-site-association for
	     eaglegoodstrading.com/app/* — flagged as needs-from-Sukh/server) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:eaglegoodstrading.com</string>
	</array>
</dict>
</plist>
